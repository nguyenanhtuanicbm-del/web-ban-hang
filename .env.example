# Lấy các giá trị này trong Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# CHỈ dùng ở server (API routes), KHÔNG bao giờ lộ ra client. Lấy ở cùng trang API settings (mục service_role).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Tên cửa hàng hiển thị trên website (tuỳ chọn)
NEXT_PUBLIC_STORE_NAME=Cửa hàng của bạn
